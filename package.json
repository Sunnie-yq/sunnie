{
  "name": "sunnie-todo",
  "version": "1.0.0",
  "description": "A quiet floating desktop todo companion",
  "main": "src/main.cjs",
  "scripts": {"start":"electron .", "test":"node --test", "pack:mac":"electron-builder --mac dir", "dist:mac":"electron-builder --mac dmg"},
  "devDependencies": {"electron":"^40.0.0", "electron-builder":"^26.0.0"},
  "build": {"appId":"com.sunnie.todo", "productName":"Sunnie", "files":["src/**/*","package.json"], "mac":{"category":"public.app-category.productivity", "target":["dmg"]}}
}
